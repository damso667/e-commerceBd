# ============================================================
#  Variables d'environnement LOCALES - NE JAMAIS COMMITER
# Modele a copier en .env puis a remplir. Ce fichier-ci EST commite.
# ============================================================

# ---------- Base de donnees (Supabase - Transaction Pooler) ----------
DB_HOST=xxxxx.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USERNAME=postgres.xxxxxxxxxxxx
DB_PASSWORD=votre_mot_de_passe

# ---------- Application ----------
SERVER_PORT=8080
JPA_DDL_AUTO=update
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://mon-projet-frontend-9b5q.vercel.app

# ---------- Paiement : mode global ----------
# simulation = passerelle simulee (aucun appel reseau)
# reel       = vraies API MTN MoMo / Orange Money
PAIEMENT_MODE=simulation

# ---------- Simulation ----------
# Delai avant que la passerelle simulee renvoie le resultat final (ms)
PAIEMENT_SIMULATION_DELAI_MS=4000
# Secret utilise pour signer les callbacks simules (HMAC-SHA256)
PAIEMENT_WEBHOOK_SECRET=changez-moi

# ---------- MTN Mobile Money (a remplir le jour du passage en reel) ----------
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_CALLBACK_URL=http://localhost:8080/api/paiements/webhook/MTN_MOMO

# ---------- Orange Money (a remplir le jour du passage en reel) ----------
ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_CALLBACK_URL=http://localhost:8080/api/paiements/webhook/ORANGE_MONEY
